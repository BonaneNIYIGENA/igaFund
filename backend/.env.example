# Copy to .env and fill in. Never commit the real file.

FLASK_CONFIG=dev
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
DATABASE_URL=sqlite:///igafund_dev.db

# Cloudinary holds uploaded documents and photos; the database stores only the link.
# Leave blank in development and uploads fall back to local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated origins allowed to call the API in production
CORS_ORIGINS=

# The deployed frontend URL — used to build links inside emails (password reset, etc).
# Leave unset in development; it falls back to http://localhost:5173.
FRONTEND_URL=

# SMTP for transactional email; logs to the console when unset
MAIL_SERVER=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# Proxy hops to trust for client IP; 0 means trust none.
# Render sits behind one reverse proxy, so set this to 1 when deployed there.
TRUSTED_PROXY_HOPS=0
