# Must end in /api — the backend mounts every blueprint under that prefix.
# Vercel's own VITE_API_URL (set in its dashboard) overrides this for the web
# build; this is the fallback baked into any other production build — e.g. the
# Android APK — that isn't run through Vercel's build environment.
VITE_API_URL=https://igafund-api.onrender.com/api
